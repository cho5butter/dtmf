---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "公衆電話向け DTMF トーンを Web Audio API で生成する静的ツール" } =
  Astro.props;
const base = import.meta.env.BASE_URL;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={description} />
<meta
  http-equiv="Content-Security-Policy"
  content="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self'; connect-src 'none'; frame-ancestors 'self'; base-uri 'self'; form-action 'none';"
/>
<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
<title>{title}</title>
