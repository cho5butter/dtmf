---
import Base from "../layouts/Base.astro";
import BrandLogo from "../components/BrandLogo.astro";
import PhoneApp from "../islands/PhoneApp";
---

<Base title="ピポる | WEB DIALER / DTMF">
  <main class="stage">
    <header class="brand">
      <BrandLogo />
    </header>
    <p
      id="audio-unsupported"
      class="audio-error"
      style="display:none"
      role="alert"
    >
      お使いのブラウザは Web Audio API に対応していません
    </p>
    <PhoneApp client:only="solid-js" />
    <footer class="site-footer">
      <small>&copy; 2026</small>
    </footer>
  </main>
</Base>
