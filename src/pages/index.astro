---
import Base from "../layouts/Base.astro";
import Footer from "../components/Footer.astro";
import PhoneApp from "../islands/PhoneApp";
---

<Base title="DTMF Web Dialer">
  <div class="app-shell page">
    <header class="page-header">
      <p class="page-header__eyebrow">DTMF</p>
      <h1 class="page-header__title">Web Dialer</h1>
      <p class="page-header__lead">
        キーで番号を入力し、下の欄に表示。再生ですべてのトーンを順に鳴らします。
      </p>
      <p
        id="audio-unsupported"
        class="mt-3 hidden rounded-xl border border-amber-500/30 bg-amber-500/10 px-4 py-3 text-sm text-amber-200"
        role="alert"
      >
        お使いのブラウザは Web Audio API に対応していません。
      </p>
    </header>
    <main>
      <PhoneApp client:only="solid-js" />
    </main>
    <Footer />
  </div>
</Base>
