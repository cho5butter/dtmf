---
import Base from "../layouts/Base.astro";
import Footer from "../components/Footer.astro";
import PhoneApp from "../islands/PhoneApp";
---

<Base title="DTMF / Web Dialer">
  <main class="stage">
    <header class="brand">
      <span class="brand__mark">DTMF</span>
      <span class="brand__divider">/</span>
      <span class="brand__name">WEB DIALER</span>
      <span class="brand__meta">2026 · Tone Generator</span>
    </header>
    <p
      id="audio-unsupported"
      class="audio-error"
      style="display:none"
      role="alert"
    >
      お使いのブラウザは Web Audio API に対応していません
    </p>
    <PhoneApp client:only="solid-js" />
  </main>
</Base>
