{
  "name": "dtmf",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "bun": {
    "jsx": {
      "importSource": "solid-js",
      "runtime": "solid"
    }
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "test": "bun test tests/unit tests/component",
    "test:e2e": "playwright test",
    "size-limit": "size-limit"
  },
  "dependencies": {
    "@astrojs/solid-js": "5.1.3",
    "astro": "5.18.1",
    "solid-js": "1.9.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "@biomejs/biome": "2.4.15",
    "@playwright/test": "1.60.0",
    "@size-limit/file": "12.1.0",
    "@solidjs/testing-library": "0.8.10",
    "@tailwindcss/vite": "4.2.1",
    "happy-dom": "20.9.0",
    "size-limit": "12.1.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.8.3"
  },
  "size-limit": [
    {
      "name": "Client JS (gzip)",
      "path": "dist/_astro/*.js",
      "gzip": true,
      "limit": "100 KB"
    }
  ]
}
