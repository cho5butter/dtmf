{
  "name": "dtmf",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "bun": {
    "jsx": {
      "importSource": "solid-js",
      "runtime": "solid"
    }
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "test": "bun test tests/unit tests/component",
    "test:e2e": "playwright test",
    "size-limit": "size-limit"
  },
  "dependencies": {
    "@astrojs/solid-js": "7.0.1",
    "astro": "7.1.3",
    "solid-js": "1.9.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@biomejs/biome": "2.5.3",
    "@playwright/test": "1.61.1",
    "@size-limit/file": "12.1.0",
    "@solidjs/testing-library": "0.8.10",
    "@tailwindcss/vite": "4.3.2",
    "happy-dom": "20.10.6",
    "size-limit": "13.0.3",
    "tailwindcss": "4.3.2",
    "typescript": "7.0.2"
  },
  "size-limit": [
    {
      "name": "Client JS (gzip)",
      "path": "dist/_astro/*.js",
      "gzip": true,
      "limit": "100 KB"
    }
  ],
  "overrides": {
    "svgo": "4.0.2",
    "sharp": "0.35.3",
    "js-yaml": "4.3.0"
  }
}
